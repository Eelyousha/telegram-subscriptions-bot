# Subscription Tracker - Configuration
# Copy this file to .env and fill in the values

# ===================
# Required
# ===================

# Telegram Bot Token from @BotFather
BOT_TOKEN=8527193973:AAFp7fgbL5LudE37Q1GKP1RzB96r7ErN-XI

# ===================
# PostgreSQL
# ===================

POSTGRES_USER=subscriptions
POSTGRES_PASSWORD=subscriptions
POSTGRES_DB=subscriptions

# Connection string (used by API, constructed from above or set directly)
# DATABASE_URL=postgresql+asyncpg://subscriptions:subscriptions@postgres:5432/subscriptions

# ===================
# API
# ===================

# API URL for bot to connect (inside docker network)
API_URL=http://api:8000

# API server binding
API_HOST=0.0.0.0
API_PORT=8000

# ===================
# Scheduler
# ===================

# Hour to send daily notifications (0-23, server timezone)
NOTIFICATION_HOUR=10

# ===================
# Logging
# ===================

LOG_LEVEL=INFO
LOG_FORMAT=json

# ===================
# Rate limiting
# ===================

# Messages per minute per user
THROTTLE_RATE=30

# ===================
# Monitoring
# ===================

# Grafana admin password (change in production!)
GRAFANA_PASSWORD=admin
